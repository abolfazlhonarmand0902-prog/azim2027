{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "azim2027",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "cafa35c8-63b0-4b90-a4e4-6ab0b178c1e7","database_name": "azim2027" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "790dd38211f841aba6dcacc58e67aa81" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
